{
  "color": {
    "brand": { "value": "#1F4E8C", "note": "Primary actions, links, selected states" },
    "brand-strong": { "value": "#173B6A", "note": "Hover and pressed state of brand" },
    "on-brand": { "value": "#FFFFFF", "note": "Text and icons on brand" },
    "brand-subtle": { "value": "#EEF4FC", "note": "Selected background, info alerts" },
    "text": { "value": "#1A1F2B", "note": "Body text" },
    "text-muted": { "value": "#4A5468", "note": "Helper text, captions" },
    "surface": { "value": "#FFFFFF", "note": "Page and card background" },
    "surface-alt": { "value": "#F4F6FA", "note": "Section background" },
    "border": { "value": "#7C8597", "note": "Input and control borders (3:1 for non-text)" },
    "focus": { "value": "#2E6BD1", "note": "Keyboard focus ring" },
    "danger": { "value": "#B42318", "note": "Errors and destructive actions" },
    "danger-subtle": { "value": "#FEF3F2", "note": "Error alert background" },
    "success": { "value": "#067647", "note": "Success text and icons" },
    "success-subtle": { "value": "#ECFDF3", "note": "Success alert background" },
    "warning": { "value": "#7A4B00", "note": "Warning text and icons" },
    "warning-subtle": { "value": "#FFFAEB", "note": "Warning alert background" },
    "disabled-text": { "value": "#5B6474", "note": "Disabled text" },
    "disabled-bg": { "value": "#E4E7EC", "note": "Disabled background" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px" },
  "radius": { "sm": "4px", "md": "8px", "lg": "12px", "pill": "999px" },
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "size-sm": "0.875rem",
    "size-md": "1rem",
    "size-lg": "1.25rem",
    "size-xl": "1.75rem",
    "weight-regular": "400",
    "weight-bold": "600"
  },
  "target": { "min": "44px" },
  "contrastPairs": [
    { "fg": "text", "bg": "surface", "min": 4.5, "use": "Body text" },
    { "fg": "text-muted", "bg": "surface", "min": 4.5, "use": "Helper text" },
    { "fg": "text-muted", "bg": "surface-alt", "min": 4.5, "use": "Helper text on section background" },
    { "fg": "on-brand", "bg": "brand", "min": 4.5, "use": "Primary button label" },
    { "fg": "on-brand", "bg": "brand-strong", "min": 4.5, "use": "Primary button hover" },
    { "fg": "brand", "bg": "surface", "min": 4.5, "use": "Links and secondary button" },
    { "fg": "brand", "bg": "brand-subtle", "min": 4.5, "use": "Selected tab and info alert" },
    { "fg": "danger", "bg": "surface", "min": 4.5, "use": "Error message" },
    { "fg": "danger", "bg": "danger-subtle", "min": 4.5, "use": "Error alert" },
    { "fg": "success", "bg": "success-subtle", "min": 4.5, "use": "Success alert" },
    { "fg": "warning", "bg": "warning-subtle", "min": 4.5, "use": "Warning alert" },
    { "fg": "disabled-text", "bg": "disabled-bg", "min": 4.5, "use": "Disabled button label (kept readable)" },
    { "fg": "border", "bg": "surface", "min": 3, "use": "Input borders (non-text contrast)" },
    { "fg": "focus", "bg": "surface", "min": 3, "use": "Focus ring (non-text contrast)" }
  ]
}
